<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="urc_arena">

  <!-- Mars Terrain (custom model) -->
<include>
  <uri>model://mars_terrain</uri>
  <name>mars_terrain</name>
  <!-- Adjust pose to sit flush with z=0 as needed -->
  <pose>0 0 0 0 0 0</pose>
</include>

    <!-- 1. Lighting and Physics - MARTIAN ENVIRONMENT -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>  <!-- Neutral ambient light -->
      <background>0.9 0.9 0.95 1</background>  <!-- Pale blue/white backdrop -->
      <shadows>true</shadows>
      <sky>
        <time>12</time>
        <sunrise>6</sunrise>
        <clouds>
          <speed>12</speed>
        </clouds>
        <horizon>
          <color>0.8 0.85 0.9 1</color>  <!-- Soft grey/blue horizon -->
        </horizon>
        <zenith>
          <color>0.9 0.95 1 1</color>  <!-- Light neutral zenith -->
        </zenith>
      </sky>
    </scene>

    <!-- Martian Sun - smaller, more distant, dimmer -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 -0 0</pose>
      <diffuse>1 1 1 1</diffuse>  <!-- Neutral white light -->
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.7</constant>  <!-- Dimmer overall -->
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <intensity>0.8</intensity>  <!-- Reduced intensity for Martian sun -->
    </light>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -3.71</gravity> <!-- Mars Gravity -->
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- 2. Remove ground_plane since we're using mars_terrain -->
    <!-- Ground plane removed to use mars_terrain exclusively -->

    <!-- 3. Terrain Obstacles (Rocks & Mountains) - Martian colors -->
    <!-- Simple Rocks with Martian coloration -->
    <model name="rock_1">
      <static>true</static>
      <pose>5 8 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material>
            <ambient>0.6 0.3 0.2 1</ambient>
            <diffuse>0.7 0.4 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>-10 -15 0.5 0 0 0.5</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.5 0.8 1</size></box></geometry>
          <material>
            <ambient>0.5 0.25 0.15 1</ambient>
            <diffuse>0.6 0.35 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision"><geometry><box><size>1.5 0.8 1</size></box></geometry></collision>
      </link>
    </model>
     <model name="rock_3">
      <static>true</static>
      <pose>12 -7 0.15 0 0 0.2</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.5 0.3 0.2 1</diffuse>
            <specular>0.1 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.3</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Background Mountains with volcanic basalt appearance -->
    <model name="mountain_1">
        <static>true</static>
        <pose>-50 0 -10 0 0 0.5</pose>
        <link name="link">
            <visual name="visual">
                <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mountain dense/1/files/meshes/mountain.dae</uri><scale>0.05 0.05 0.05</scale></mesh></geometry>
                 <material>
                   <ambient>0.3 0.15 0.1 1</ambient>
                   <diffuse>0.4 0.25 0.2 1</diffuse>
                   <specular>0.05 0.05 0.05 1</specular>
                 </material>
            </visual>
        </link>
    </model>
    <model name="mountain_2">
        <static>true</static>
        <pose>45 60 -15 0 0 -1.2</pose>
        <link name="link">
            <visual name="visual">
                <geometry><mesh><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mountain dense/1/files/meshes/mountain.dae</uri><scale>0.08 0.08 0.04</scale></mesh></geometry>
                 <material>
                   <ambient>0.25 0.12 0.08 1</ambient>
                   <diffuse>0.35 0.2 0.15 1</diffuse>
                   <specular>0.03 0.03 0.03 1</specular>
                 </material>
            </visual>
        </link>
    </model>

    <!-- 4. Competition Objects -->
    <!--SDRC objects (your custom models) -->
    <include>
      <uri>model://sdrc_mallet</uri>
      <name>sdrc_mallet</name>
      <pose>10 -5 1.2330 5 0.955644 0</pose>
    </include>

    <include>
      <uri>model://sdrc_water_bottle</uri>
      <name>sdrc_water_bottle</name>
      <pose>-5 8 0.4500 0 0 0</pose>
    </include>

    <include>
    <uri>model://hammer</uri>
      <name>hammer</name>
      <pose>1 1 1 0 0 0</pose>
    </include>

    <!-- 7. AR Tag Posts -->
    <include>
      <uri>model://start_pole</uri>
      <name>start_gate</name>
      <pose>0 2 -2 0 0 0</pose>
    </include>

    <include>
      <uri>model://pole1</uri>
      <name>ar_post_1</name>
      <pose>20 5 -2 0 0 0</pose>
    </include>

    <include>
      <uri>model://pole2</uri>
      <name>ar_post_2</name>
      <pose>-10 -9-2 0 0 0</pose>
    </include>

    <include>
      <uri>model://pole3</uri>
      <name>ar_post_3</name>
      <pose>10 -20 -2 0 0 0</pose>
    </include>

  </world>
</sdf>
